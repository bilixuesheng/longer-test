     // 这时 start() 不会重新开始，数字就停在透明度 0，整整一秒看不到。先 stop() 再 start() 保证每秒都从头播放
     m_countdownGroup->stop();
     m_countdownGroup->start();
+    scheduleNextTick();
 }
 
