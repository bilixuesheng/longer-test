+
+void EventPointReminder::scheduleNextTick()
+{
+    // 原来是每 1000ms 一次的普通（粗精度）计时器，触发时刻可能贴着整秒，前后抖几毫秒就会落到整秒的另一边，
+    // secsTo() 算出的数字就会跳过一个或重复一个。改成每次都在下一个整秒刚过 50ms 时触发
+    m_timer->start(1000 - QTime::currentTime().msec() + 50);
 }
 
