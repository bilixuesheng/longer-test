+
+/* ------------------------------------------------------------
+   12.1 主站 / 交流群（与 www.longer.xin 互通）
+   形状、硬投影、像素字体仍是本站的；
+   蓝色、青→紫渐变、头像转圈来自主站，只出现在这些元素上
+   ------------------------------------------------------------ */
+
+/* 行内链接：指向主站或交流群 */
+.blue-link{
+  color:var(--www-2);text-decoration:none;
+  border-bottom:1px dashed rgba(0,174,236,.5);
+  transition:color .18s,border-color .18s,text-shadow .18s;
+}
+.blue-link:hover{
+  color:#fff;border-bottom-style:solid;border-color:var(--www);
+  text-shadow:0 0 12px rgba(0,174,236,.6);
+}
+
+/* 小号蓝色方块入口：导航“主站”、交流群“加群” */
+.nav-home,.community-join{
+  display:inline-flex;align-items:center;gap:6px;flex:none;
+  padding:8px 11px;
+  font-size:12.5px;font-weight:700;line-height:1;white-space:nowrap;
+  color:var(--www-2);text-decoration:none;
+  background:rgba(0,174,236,.07);
+  border:1px solid rgba(0,174,236,.32);
+  box-shadow:2px 2px 0 rgba(0,0,0,.35);
+  transition:color .18s,background .18s,border-color .18s,box-shadow .18s;
+}
+.nav-home .icon,.community-join .icon{width:13px;height:13px}
+.nav-home:hover,.community-join:hover{
+  color:#fff;background:rgba(0,174,236,.14);border-color:rgba(0,174,236,.62);
+  box-shadow:2px 2px 0 rgba(0,0,0,.35),0 3px 24px rgba(0,174,236,.35);
+}
+
+/* Hero 状态行：交流群 */
+.live-qq{color:var(--muted);text-decoration:none;transition:color .18s}
+.live-qq code{color:var(--text-2);font-size:12.5px;letter-spacing:.3px;transition:color .18s}
+.live-qq:hover,.live-qq:hover code{color:var(--www-2)}
+
+/* 加入区：交流群 */
+.community{
+  position:relative;
+  display:flex;align-items:center;gap:18px;
+  margin-top:14px;padding:18px 20px 18px 24px;
+  background:linear-gradient(180deg,#111720 0%,#0d121a 100%);
+  border:1px solid var(--line);
+  box-shadow:var(--shadow-card);
+  scroll-margin-top:110px;
+}
+.community::before{
+  content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
+  background:linear-gradient(180deg,var(--www-2),#0089bd);
+}
+.community-ico{
+  width:40px;height:40px;flex:none;display:grid;place-items:center;
+  color:var(--www-2);
+  background:rgba(0,174,236,.09);
+  border:1px solid rgba(0,174,236,.28);
+  box-shadow:2px 2px 0 rgba(0,0,0,.3);
+}
+.community-ico .icon{width:19px;height:19px}
+.community-text{flex:1;min-width:0}
+.community-text h3{font-size:15px;font-weight:800;line-height:1.5}
+.community-text p{margin-top:3px;font-size:13px;line-height:1.8;color:var(--muted)}
+.community-actions{display:flex;align-items:center;gap:10px;flex:none}
+.community-num{display:flex;flex-direction:column;gap:6px;margin-right:4px}
+.community-num code{font-size:16px;line-height:1.1;letter-spacing:.6px;color:#fff}
+.community .ip-copy{color:var(--www-2);background:rgba(0,174,236,.1);border-color:rgba(0,174,236,.32)}
+.community .ip-copy:hover{color:#fff;background:rgba(0,174,236,.2)}
+
+/* 页脚：主站卡片 */
+.footer-home{
+  position:relative;
+  max-width:1220px;margin:44px auto 0;
+  display:flex;align-items:center;gap:20px;
+  padding:22px 24px;
+  background:linear-gradient(180deg,rgba(0,174,236,.055) 0%,rgba(0,174,236,.015) 100%);
+  border:1px solid rgba(0,174,236,.2);
+  box-shadow:6px 6px 0 rgba(0,0,0,.24);
+}
+/* 主站横幅的青→紫渐变，切成像素虚线 */
+.footer-home::before{
+  content:'';position:absolute;left:-1px;right:-1px;top:-1px;height:3px;
+  background:var(--www-grad);
+  -webkit-mask:repeating-linear-gradient(90deg,#000 0 12px,transparent 12px 16px);
+  mask:repeating-linear-gradient(90deg,#000 0 12px,transparent 12px 16px);
+}
+.footer-home-avatar{
+  width:56px;height:56px;flex:none;display:block;object-fit:cover;
+  border:1px solid #000;
+  outline:1px solid rgba(0,174,236,.45);outline-offset:2px;
+  box-shadow:3px 3px 0 rgba(0,0,0,.4);
+  transition:transform .5s var(--ease);
+}
+/* 主站头像悬停转圈，换成方形版本 */
+.footer-home:hover .footer-home-avatar{transform:rotate(360deg)}
+.footer-home-text{flex:1;min-width:0}
+.footer-home-kicker{
+  display:block;
+  font-family:var(--pixel);font-size:7px;line-height:1.4;letter-spacing:1.4px;
+  color:var(--muted-2);
+}
+.footer-home-kicker em{margin-left:6px;font-family:var(--sans);font-size:11px;font-style:normal;letter-spacing:0;color:var(--muted)}
+.footer-home-title{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-top:8px;line-height:1.3}
+.footer-home-title b{font-size:19px;font-weight:900;color:var(--www-2);text-shadow:0 0 18px rgba(0,174,236,.35)}
+.footer-home-title code{font-size:12.5px;letter-spacing:.3px;color:var(--text-2)}
+.footer-home-desc{max-width:620px;margin-top:6px;font-size:12.5px;line-height:1.85;color:var(--muted)}
+.footer-home-actions{display:flex;align-items:center;gap:18px;flex:none}
+.footer-qq{
+  display:inline-flex;align-items:center;gap:7px;
+  font-size:12.5px;color:var(--muted);text-decoration:none;white-space:nowrap;
+  transition:color .18s;
+}
+.footer-qq .icon{width:15px;height:15px;color:var(--www-2)}
+.footer-qq code{color:var(--text-2);transition:color .18s}
+.footer-qq:hover,.footer-qq:hover code{color:var(--www-2)}
+
+/* 蓝色的像素按钮：只给“访问主站”用 */
+.btn-www{
+  color:#03141c;
+  background:linear-gradient(180deg,#7cdcfc 0%,#22bdf2 55%,#00a5df 100%);
+  border-color:#021018;
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.4),
+    inset 0 -2px 0 rgba(0,0,0,.2),
+    0 4px 0 #00658c;
+}
+.btn-www:hover{
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.4),
+    inset 0 -2px 0 rgba(0,0,0,.2),
+    0 4px 0 #00658c,
+    0 3px 26px rgba(0,174,236,.45);
+}
+.btn-www:active{
+  box-shadow:
+    inset 0 2px 0 rgba(255,255,255,.3),
+    inset 0 -2px 0 rgba(0,0,0,.25),
+    0 1px 0 #00658c;
+}
 
